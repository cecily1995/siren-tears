# Copy this file to .env.local and fill in your Sanity project values.
# Create a free Sanity project at https://www.sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-09-01

# Optional: a read token if you want to preview drafts
SANITY_API_READ_TOKEN=

# Required for the Bespoke request form to save submissions to Sanity.
# Create at sanity.io/manage -> your project -> API -> Tokens -> Add API token
# Permissions: Editor (write access). Keep this secret — server-side only, never NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Required for the "auto-mark product as Sold" automation. Make up any random
# string, put it here AND as ?secret=... on the webhook URL you configure at
# sanity.io/manage -> API -> Webhooks (see README/chat instructions).
SANITY_WEBHOOK_SECRET=

# Required for the email/password account system (register/login/session
# cookie). Make up any long random string and put it here AND in Vercel as
# an environment variable. Never share it.
SESSION_SECRET=
