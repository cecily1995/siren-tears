# Copy this file to .env.local and fill in your Sanity project values.
# Create a free Sanity project at https://www.sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-09-01

# Optional: a read token if you want to preview drafts
SANITY_API_READ_TOKEN=
